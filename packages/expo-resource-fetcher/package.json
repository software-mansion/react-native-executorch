{
  "name": "react-native-executorch-expo-resource-fetcher",
  "version": "0.10.0",
  "description": "Expo resource fetcher for react-native-executorch",
  "main": "lib/index.js",
  "// === LEGACY SUPPORT: exports ===": "exports['./legacy'] provides legacy resource fetcher support (remove when legacy API is dropped)",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./legacy": {
      "import": "./lib/legacy/index.js",
      "types": "./lib/legacy/index.d.ts"
    }
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/software-mansion/react-native-executorch.git",
    "directory": "packages/expo-resource-fetcher"
  },
  "scripts": {
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib"
  },
  "peerDependencies": {
    "expo": ">=54.0.0",
    "expo-asset": ">=12.0.0",
    "expo-file-system": ">=19.0.0",
    "react-native": "*",
    "react-native-executorch": "*"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "expo": "^57.0.20",
    "expo-asset": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-executorch": "workspace:*",
    "typescript": "~7.0.2"
  }
}
