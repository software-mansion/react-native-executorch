{
  "name": "computer-vision",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "react-native-executorch": {
    "features": [
      "classification",
      "depthEstimation",
      "imageEmbeddings",
      "textEmbeddings",
      "instanceSegmentation",
      "keypointDetection",
      "objectDetection",
      "ocr",
      "semanticSegmentation",
      "styleTransfer",
      "textToImage"
    ]
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc",
    "lint": "eslint . --ext .ts,.tsx --fix"
  },
  "dependencies": {
    "@react-navigation/drawer": "^7.14.4",
    "@react-navigation/native": "^7.5.1",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.14",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-device": "~58.0.5",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-blob-util": "^0.25.0",
    "react-native-drawer-layout": "^4.2.2",
    "react-native-executorch": "workspace:*",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-image-picker": "^8.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@react-native/metro-config": "^0.88.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.17",
    "react-native-svg-transformer": "^1.5.3",
    "react-refresh": "^0.19.0"
  },
  "private": true
}
