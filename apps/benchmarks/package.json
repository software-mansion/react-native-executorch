{
  "name": "benchmarks",
  "version": "1.0.0",
  "main": "index.ts",
  "react-native-executorch": {
    "backends": [
      "xnnpack",
      "coreml",
      "mlx",
      "vulkan"
    ],
    "libs": [
      "opencv",
      "phonemis"
    ]
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "bench": "node scripts/run-benchmarks.mjs",
    "bench:compare": "node scripts/compare.mjs",
    "bench:summary": "node scripts/summarize.mjs",
    "bench:sizes": "node scripts/fetch-variant-sizes.mjs",
    "bench:docs": "node scripts/docs-data.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "expo": "~57.0.28",
    "expo-build-properties": "~57.0.22",
    "expo-keep-awake": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-blob-util": "^0.25.0",
    "react-native-executorch": "workspace:*",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/metro-config": "^0.86.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.15",
    "react-refresh": "^0.14.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
