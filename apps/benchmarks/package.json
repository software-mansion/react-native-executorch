{
  "name": "benchmarks",
  "version": "1.0.0",
  "main": "index.ts",
  "react-native-executorch": {
    "backends": [
      "xnnpack",
      "coreml",
      "mlx",
      "vulkan"
    ],
    "libs": [
      "opencv",
      "phonemis"
    ]
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "bench": "node scripts/run-benchmarks.mjs",
    "bench:compare": "node scripts/compare.mjs",
    "bench:summary": "node scripts/summarize.mjs",
    "bench:sizes": "node scripts/fetch-variant-sizes.mjs",
    "bench:docs": "node scripts/docs-data.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "expo": "~58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-keep-awake": "~58.0.3",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-blob-util": "^0.25.0",
    "react-native-executorch": "workspace:*",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@react-native/metro-config": "^0.88.1",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.20",
    "react-refresh": "^0.19.0",
    "typescript": "~7.0.2"
  },
  "private": true
}
