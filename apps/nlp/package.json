{
  "name": "nlp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "react-native-executorch": {
    "backends": [
      "xnnpack",
      "coreml",
      "mlx",
      "vulkan"
    ],
    "features": [
      "tokenizer",
      "textEmbeddings",
      "privacyFilter",
      "multimodalLLM"
    ]
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc",
    "lint": "eslint . --ext .ts,.tsx --fix"
  },
  "dependencies": {
    "@react-navigation/drawer": "^7.14.3",
    "@react-navigation/native": "^7.5.0",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.7",
    "expo-build-properties": "~58.0.10",
    "expo-constants": "~58.0.10",
    "expo-image-manipulator": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.11",
    "expo-router": "~58.0.17",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-blob-util": "^0.25.0",
    "react-native-drawer-layout": "^4.2.2",
    "react-native-executorch": "workspace:*",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.29.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@react-native/metro-config": "^0.87.1",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.12",
    "react-native-svg-transformer": "^1.5.3",
    "react-refresh": "^0.19.0"
  },
  "private": true
}
